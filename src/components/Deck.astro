---
// The slide viewer. Each slide fills the screen; scroll, swipe, or use the
// keyboard to move between them. Press ? on a deck to see every shortcut.
import type { Deck } from '../lib/decks';

interface Props {
  deck: Deck;
}

const { deck } = Astro.props;
---

<div class="deck-shell" data-slug={deck.slug}>
  <main class="deck" tabindex="-1">
    {
      deck.slides.map((slide) => (
        <section
          class:list={['slide', `layout-${slide.layout}`]}
          id={`${slide.index + 1}`}
          data-index={slide.index}
          data-heading={slide.heading}
          aria-label={`Slide ${slide.index + 1}`}
        >
          {slide.background && <img class="slide-bg" src={slide.background.src} alt={slide.background.alt} />}
          {slide.inset && <img class="slide-inset" src={slide.inset.src} alt={slide.inset.alt} />}
          {slide.layout === 'two-col' ? (
            <div class="slide-inner">
              <div class="col" set:html={slide.html} />
              <div class="col" set:html={slide.rightHtml ?? ''} />
            </div>
          ) : (
            <div class="slide-inner" set:html={slide.html} />
          )}
          {slide.notes && <template class="slide-notes" set:html={slide.notes} />}
        </section>
      ))
    }
  </main>

  <div class="deck-progress" aria-hidden="true"><div class="deck-progress-bar"></div></div>

  <nav class="deck-chrome" aria-label="Slide controls">
    <a href="/lesson" class="chrome-btn" title="All lessons">☰</a>
    <button class="chrome-btn" data-action="prev" title="Previous (←)">‹</button>
    <span class="deck-counter"><span data-current>1</span> / {deck.slides.length}</span>
    <button class="chrome-btn" data-action="next" title="Next (→)">›</button>
    <button class="chrome-btn" data-action="help" title="Shortcuts (?)">?</button>
  </nav>

  <aside class="deck-notes" hidden>
    <div class="notes-header">
      <strong>Speaker notes</strong>
      <span class="notes-timer" data-timer>0:00</span>
    </div>
    <div class="notes-body" data-notes></div>
    <div class="notes-next">Next: <span data-next></span></div>
  </aside>

  <dialog class="deck-help">
    <h2>Shortcuts</h2>
    <dl>
      <dt>→ ↓ Space</dt><dd>Next slide</dd>
      <dt>← ↑</dt><dd>Previous slide</dd>
      <dt>Home / End</dt><dd>First / last slide</dd>
      <dt>N</dt><dd>Show speaker notes</dd>
      <dt>P</dt><dd>Open presenter window (notes + timer, stays in sync)</dd>
      <dt>F</dt><dd>Full screen</dd>
      <dt>⌘P / Ctrl+P</dt><dd>Print or save as PDF (one slide per page)</dd>
    </dl>
    <form method="dialog"><button class="chrome-btn">Close</button></form>
  </dialog>
</div>

<style is:global>
  .deck-shell {
    --chrome-h: 3rem;
    position: fixed;
    inset: 0;
    display: flex;
    background: var(--color-paper);
  }

  .deck {
    flex: 1;
    height: 100dvh;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    outline: none;
    scrollbar-width: none;
  }
  .deck::-webkit-scrollbar { display: none; }

  /* ---- One slide ---- */
  .slide {
    container-type: size;
    position: relative;
    height: 100dvh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  /* Text scales with the slide, so it looks the same on a laptop or a projector. */
  .slide-inner {
    font-size: max(15px, min(2.3cqw, 4cqh));
    width: min(88cqw, 150cqh);
    max-height: 90cqh;
    line-height: 1.45;
  }

  .slide-inner :is(h1, h2, h3) {
    font-family: var(--font-display);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 0.5em;
    text-wrap: balance;
  }
  .slide-inner h1 { font-size: 2.8em; font-weight: 800; }
  .slide-inner h2 { font-size: 2em; font-weight: 750; }
  .slide-inner h3 { font-size: 1.3em; font-weight: 650; color: var(--color-brand); }
  .slide-inner p { margin: 0 0 0.7em; text-wrap: pretty; }
  .slide-inner ul, .slide-inner ol { margin: 0 0 0.7em; padding-left: 1.2em; }
  /* Tailwind resets list styles, so bring the bullets and numbers back. */
  .slide-inner ul { list-style: disc; }
  .slide-inner ol { list-style: decimal; }
  .slide-inner ol > li::marker { font-weight: 700; }
  .slide-inner li { margin: 0.25em 0; }
  .slide-inner li::marker { color: var(--color-brand); }
  .slide-inner strong { color: var(--color-brand-dark); }
  .slide-inner a { color: var(--color-brand); text-underline-offset: 0.15em; }
  .slide-inner img { max-width: 100%; max-height: 60cqh; border-radius: 0.5em; }
  .slide-inner code {
    font-size: 0.85em;
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
    padding: 0.1em 0.35em;
    border-radius: 0.3em;
  }
  /* Code blocks look like a small editor window. */
  .slide-inner pre {
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 0.8em 1em;
    border-radius: 0.5em;
    font-size: 0.7em;
    line-height: 1.5;
    white-space: pre-wrap;
    box-shadow: 0 1em 2.5em -1em #0006;
  }
  .slide-inner pre::before {
    content: '● ● ●';
    display: block;
    margin-bottom: 0.6em;
    letter-spacing: 0.2em;
    color: var(--color-muted);
    font-size: 0.8em;
  }
  .slide-inner pre code { background: none; padding: 0; }
  /* Blockquotes are used for prompts, so they look like a chat message. */
  .slide-inner blockquote {
    margin: 0 0 0.7em;
    padding: 0.7em 1em;
    border-left: 0.25em solid var(--color-sun);
    border-radius: 0.2em 0.8em 0.8em 0.2em;
    background: #fff;
    color: var(--color-ink);
    box-shadow: 0 0.8em 2em -1em #0003;
  }
  .slide-inner blockquote p:last-child { margin-bottom: 0; }
  .slide-inner table { border-collapse: collapse; font-size: 0.85em; }
  .slide-inner :is(th, td) { padding: 0.35em 0.8em; border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent); text-align: left; }

  /* ---- Layouts (pick one per slide with <!-- layout: name -->) ---- */
  .layout-title .slide-inner { text-align: center; }
  .layout-title h1 { font-size: 3.6em; }
  .layout-title p { font-size: 1.3em; color: var(--color-muted); }

  .layout-section { background: var(--color-brand); color: var(--color-paper); }
  .layout-section .slide-inner :is(h1, h2, h3, strong, a) { color: var(--color-paper); }
  .layout-section h2 { font-size: 3.2em; }
  .layout-section li::marker { color: var(--color-sun); }

  .layout-statement { background: var(--color-ink); color: var(--color-paper); }
  .layout-statement .slide-inner { text-align: center; }
  .layout-statement .slide-inner :is(h1, h2) { font-size: 3em; }
  .layout-statement .slide-inner strong { color: var(--color-sun); }
  .layout-statement .slide-inner p { font-size: 1.3em; opacity: 0.85; text-wrap: balance; }
  .layout-statement .slide-inner small { font-size: 0.7em; opacity: 0.7; }

  .layout-two-col .slide-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3em;
    align-items: center;
  }

  /* Photo: the first image fills the slide, text sits on top at the bottom-left. */
  .layout-photo { place-items: end start; color: #fff; }
  .slide-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .layout-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #000a, #0000 55%);
  }
  .layout-photo .slide-inner { position: relative; z-index: 1; margin: 0 0 6cqh 6cqw; max-width: 70cqw; }
  .layout-photo .slide-inner :is(h1, h2, h3, strong) { color: #fff; text-shadow: 0 0.05em 0.4em #0006; }
  .layout-photo .slide-inner small { font-size: 0.5em; opacity: 0.7; }
  .layout-photo .slide-inner a { color: inherit; }
  /* A second image on a photo slide: a tilted postcard in the top-right corner. */
  .slide-inset {
    position: absolute;
    top: 5cqh;
    right: 4cqw;
    z-index: 2;
    width: min(42cqw, 70cqh);
    border-radius: 0.6em;
    border: 0.35em solid #fff;
    box-shadow: 0 1em 2.5em -0.5em #0007;
    transform: rotate(2deg);
  }

  /* Gallery: every image on the slide goes into a grid. */
  .layout-gallery .slide-inner p:has(img) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 0.8em;
  }
  .layout-gallery .slide-inner img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; max-height: 60cqh; border-radius: 0.5em; }

  /* Cards: each list item becomes a card. Numbered lists get a number badge.
     4 items → 2×2 grid; otherwise as many columns as there are items (up to 3). */
  .layout-cards .slide-inner :is(ol, ul) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12em), 1fr));
    gap: 0.8em;
    margin: 0.8em 0;
    padding: 0;
    list-style: none;
    counter-reset: card;
  }
  .layout-cards .slide-inner :is(ol, ul):has(> li:nth-child(4)) { grid-template-columns: 1fr 1fr; }
  .layout-cards .slide-inner li {
    position: relative;
    margin: 0;
    padding: 0.8em 1em;
    border-radius: 0.6em;
    background: #fff;
    box-shadow: 0 0.6em 1.6em -1em #0003;
    counter-increment: card;
  }
  .layout-cards .slide-inner ol > li { padding-left: 3.2em; }
  .layout-cards .slide-inner ol > li::before {
    content: counter(card);
    position: absolute;
    left: 0.8em;
    top: 0.8em;
    display: grid;
    place-items: center;
    width: 1.7em;
    height: 1.7em;
    border-radius: 999px;
    background: var(--color-brand);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95em;
  }
  .layout-cards .slide-inner li p { margin: 0; }
  /* The first line of a card is its title. */
  .layout-cards .slide-inner li > p:first-child { margin-bottom: 0.35em; font-family: var(--font-display); font-size: 1.15em; font-weight: 700; color: var(--color-brand-dark); }
  .layout-cards .slide-inner li > p:first-child strong { color: inherit; }
  .layout-cards .slide-inner li > p:first-child .km { font-family: var(--font-khmer); font-size: 0.75em; font-weight: 600; }
  .layout-cards .slide-inner li > p:not(:first-child) { font-size: 0.9em; line-height: 1.4; }
  .layout-cards .slide-inner li .km { font-size: 0.85em; }

  /* Image: one picture, as big as fits, never cropped (good for maps and diagrams). */
  .layout-image .slide-inner { width: 94cqw; max-height: 94cqh; text-align: center; }
  .layout-image .slide-inner p:has(img) { margin: 0; }
  .layout-image .slide-inner img { display: block; margin: 0 auto; width: 100%; max-height: 90cqh; object-fit: contain; border-radius: 0.6em; }

  /* Captioned images:  ![alt](/photo.jpg "Caption") */
  .slide-inner .figure { display: flex; flex-direction: column; gap: 0.3em; }
  .slide-inner .caption { font-size: 0.7em; color: var(--color-muted); text-align: center; }
  /* Never crop images in two-col: show the whole picture, as big as fits. */
  .layout-two-col .slide-inner img { display: block; margin: 0 auto; max-width: 100%; max-height: 70cqh; object-fit: contain; }

  /* Khmer captions on slides: a quieter second voice under the English.
     No colored highlights, muted, tucked close to its English line. */
  .slide-inner .km { margin-top: 0; line-height: 1.5; opacity: 0.7; }
  .slide-inner .km strong { color: inherit; font-weight: 600; }
  .slide-inner :is(h1, h2, h3) > .km { font-weight: 500; opacity: 0.65; }
  .slide-inner li .km { font-size: 0.8em; }
  .slide-inner li:has(.km) { margin: 0.55em 0; }
  .slide-inner p:has(> .km) { margin-bottom: 0.9em; }

  /* <span class="google-logo"><i>G</i><i>o</i>…</span> → the Google colors */
  .google-logo { font-weight: 600; }
  .google-logo i { font-style: normal; }
  .google-logo i:nth-child(1), .google-logo i:nth-child(4) { color: #4285f4; }
  .google-logo i:nth-child(2), .google-logo i:nth-child(6) { color: #ea4335; }
  .google-logo i:nth-child(3) { color: #fbbc05; }
  .google-logo i:nth-child(5) { color: #34a853; }

  /* ---- Controls ---- */
  .deck-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    z-index: 10;
  }
  .deck-progress-bar {
    height: 100%;
    width: 0;
    background: var(--color-sun);
    transition: width 0.3s;
  }

  .deck-chrome {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 75%, transparent);
    color: var(--color-paper);
    font-size: 0.85rem;
    opacity: 0.25;
    transition: opacity 0.2s;
    z-index: 10;
  }
  .deck-chrome:hover, .deck-chrome:focus-within { opacity: 1; }
  .deck-counter { padding: 0 0.5rem; font-variant-numeric: tabular-nums; }
  .chrome-btn {
    display: inline-grid;
    place-items: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.5rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
    text-decoration: none;
  }
  .chrome-btn:hover { background: color-mix(in srgb, var(--color-paper) 15%, transparent); }

  /* ---- Speaker notes panel ---- */
  .deck-notes {
    width: min(28rem, 38vw);
    height: 100dvh;
    overflow-y: auto;
    padding: 1.5rem;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .deck-notes[hidden] { display: none; }
  .notes-header { display: flex; justify-content: space-between; margin-bottom: 1rem; color: var(--color-sun); }
  .notes-timer { font-variant-numeric: tabular-nums; }
  .notes-body:empty::before { content: 'No notes for this slide.'; opacity: 0.5; }
  .notes-next { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #fff3; opacity: 0.7; font-size: 0.95rem; }

  .deck-help {
    border: 0;
    border-radius: 1rem;
    padding: 1.5rem 2rem;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .deck-help::backdrop { background: #0008; }
  .deck-help h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem; }
  .deck-help dl { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1.5rem; margin-bottom: 1rem; }
  .deck-help dt { font-weight: 600; }
  .deck-help .chrome-btn { background: var(--color-ink); color: var(--color-paper); font-size: 0.9rem; padding: 0 1rem; }

  /* Phones: the deck becomes a normal scrolling page. */
  @media (max-width: 640px) {
    .deck { scroll-snap-type: none; }
    .slide { height: auto; min-height: 100dvh; container-type: inline-size; padding: 3rem 0; }
    .slide-inner { font-size: max(16px, 4.2cqw); max-height: none; }
    .layout-two-col .slide-inner { grid-template-columns: 1fr; gap: 1em; }
    .layout-photo .slide-inner { margin: 0 1.5rem 2rem; max-width: none; }
    .slide-inset { width: 70cqw; top: 1.5rem; }
    .layout-gallery .slide-inner p:has(img) { grid-auto-flow: row; grid-template-columns: 1fr 1fr; }
    .layout-cards .slide-inner :is(ol, ul):has(> li:nth-child(4)) { grid-template-columns: 1fr; }
    .deck-notes { position: fixed; inset: auto 0 0 0; width: auto; height: 40dvh; }
  }

  /* Print / Save as PDF: one slide per landscape page. */
  @media print {
    @page { size: 13.333in 7.5in; margin: 0; }
    .deck-shell { position: static; display: block; }
    .deck { height: auto; overflow: visible; }
    .slide { height: 7.5in; width: 13.333in; break-after: page; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .deck-chrome, .deck-progress, .deck-notes, .deck-help { display: none !important; }
  }
</style>

<script>
  function setup() {
    const shell = document.querySelector<HTMLElement>('.deck-shell');
    if (!shell) return;

    const deck = shell.querySelector<HTMLElement>('.deck')!;
    const slides = [...shell.querySelectorAll<HTMLElement>('.slide')];
    const counter = shell.querySelector<HTMLElement>('[data-current]')!;
    const bar = shell.querySelector<HTMLElement>('.deck-progress-bar')!;
    const notesPanel = shell.querySelector<HTMLElement>('.deck-notes')!;
    const notesBody = shell.querySelector<HTMLElement>('[data-notes]')!;
    const nextLabel = shell.querySelector<HTMLElement>('[data-next]')!;
    const timerLabel = shell.querySelector<HTMLElement>('[data-timer]')!;
    const help = shell.querySelector<HTMLDialogElement>('.deck-help')!;

    // Presenter window and main window stay on the same slide via this channel.
    const channel = new BroadcastChannel(`deck-${shell.dataset.slug}`);
    const isPresenter = new URLSearchParams(location.search).has('presenter');
    let current = -1;
    // The slide we're heading to. Updated right away, so pressing → five times
    // quickly moves five slides even before the scrolling catches up.
    let target = 0;

    function goTo(i: number) {
      target = Math.max(0, Math.min(slides.length - 1, i));
      slides[target].scrollIntoView({ behavior: 'instant', block: 'start' });
    }

    function onSlideChange(i: number) {
      if (i === current) return;
      current = target = i;
      counter.textContent = String(i + 1);
      bar.style.width = `${((i + 1) / slides.length) * 100}%`;
      history.replaceState(null, '', `${location.search}#${i + 1}`);

      const tpl = slides[i].querySelector<HTMLTemplateElement>('.slide-notes');
      notesBody.innerHTML = tpl ? tpl.innerHTML : '';
      const next = slides[i + 1];
      nextLabel.textContent = next ? next.dataset.heading || `Slide ${i + 2}` : 'End of deck';

      channel.postMessage({ slide: i });
    }

    // Work out which slide is on screen, however we got there (keys, scroll, swipe).
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) onSlideChange(Number((e.target as HTMLElement).dataset.index));
        }
      },
      { root: deck, threshold: 0.6 },
    );
    slides.forEach((s) => observer.observe(s));

    channel.onmessage = (e) => {
      if (typeof e.data?.slide === 'number' && e.data.slide !== current) goTo(e.data.slide);
    };

    function toggleNotes(force?: boolean) {
      notesPanel.hidden = force === undefined ? !notesPanel.hidden : !force;
    }

    // Timer starts the first time notes are shown.
    let startedAt = 0;
    setInterval(() => {
      if (notesPanel.hidden) return;
      startedAt ||= Date.now();
      const s = Math.floor((Date.now() - startedAt) / 1000);
      timerLabel.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    }, 1000);

    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey || help.open) return;
      const key = e.key.toLowerCase();
      if (['arrowright', 'arrowdown', 'pagedown', ' '].includes(key)) goTo(target + 1);
      else if (['arrowleft', 'arrowup', 'pageup'].includes(key)) goTo(target - 1);
      else if (key === 'home') goTo(0);
      else if (key === 'end') goTo(slides.length - 1);
      else if (key === 'n') toggleNotes();
      else if (key === 'p') window.open(`${location.pathname}?presenter#${current + 1}`, `presenter-${shell.dataset.slug}`, 'width=1200,height=750');
      else if (key === 'f') document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen();
      else if (key === '?') help.showModal();
      else return;
      e.preventDefault();
    });

    shell.querySelector('[data-action="prev"]')!.addEventListener('click', () => goTo(target - 1));
    shell.querySelector('[data-action="next"]')!.addEventListener('click', () => goTo(target + 1));
    shell.querySelector('[data-action="help"]')!.addEventListener('click', () => help.showModal());

    if (isPresenter) toggleNotes(true);
    const fromHash = Number(location.hash.slice(1));
    goTo(fromHash > 0 ? fromHash - 1 : 0);
    deck.focus();
  }

  setup();
</script>
