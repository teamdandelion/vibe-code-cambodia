---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDecks } from '../lib/decks';

const steps = [
  {
    icon: '🧰',
    title: 'Choose a stack',
    titleKm: 'ជ្រើសរើស stack',
    text: 'Pick the technology the AI will use. AI can help you choose. This week, it’s chosen for you.',
    textKm: 'ជ្រើសរើសបច្ចេកវិទ្យាដែល AI នឹងប្រើ។ AI អាចជួយអ្នកជ្រើសរើសបាន។ សម្រាប់វគ្គនេះ យើងបានជ្រើសរើសរួចហើយ។',
  },
  {
    icon: '💬',
    title: 'Prompt',
    titleKm: 'ប្រាប់ AI',
    text: 'Describe the website you want, in plain words. English or Khmer.',
    textKm: 'ពិពណ៌នាគេហទំព័រដែលអ្នកចង់បាន ជាពាក្យសាមញ្ញ។ ភាសាអង់គ្លេស ឬភាសាខ្មែរក៏បាន។',
  },
  {
    icon: '🔁',
    title: 'Iterate',
    titleKm: 'កែលម្អម្តងហើយម្តងទៀត',
    text: 'Check the result and tell the AI what to improve. Repeat! This is the real skill.',
    textKm: 'ពិនិត្យលទ្ធផល ហើយប្រាប់ AI ពីអ្វីដែលត្រូវកែ។ ធ្វើម្តងទៀត! នេះគឺជាជំនាញពិតប្រាកដ។',
  },
  {
    icon: '🚀',
    title: 'Ship it',
    titleKm: 'ដាក់ឱ្យប្រើ',
    text: 'Publish it to the internet, free, at a link you can share.',
    textKm: 'ដាក់វានៅលើអ៊ីនធឺណិត ដោយឥតគិតថ្លៃ ជាមួយតំណភ្ជាប់ដែលអ្នកអាចចែករំលែកបាន។',
  },
];

const stats = [
  { value: '0', label: 'lines of code to memorize', labelKm: 'បន្ទាត់កូដដែលត្រូវទន្ទេញ' },
  { value: '1', label: 'live website each', labelKm: 'គេហទំព័រផ្ទាល់ខ្លួនម្នាក់មួយ' },
  { value: '$0', label: 'to publish it', labelKm: 'ដើម្បីដាក់វាលើអ៊ីនធឺណិត' },
];

const needs = [
  {
    title: 'An idea',
    titleKm: 'គំនិតមួយ',
    text: 'A business, a project, a club — anything you would want a website for.',
    textKm: 'អាជីវកម្ម គម្រោង ក្លឹប — អ្វីក៏បានដែលអ្នកចង់មានគេហទំព័រ។',
  },
  {
    title: 'A Mac',
    titleKm: 'កុំព្យូទ័រ Mac',
    text: 'You will set it up yourself, with the AI as your guide.',
    textKm: 'អ្នកនឹងរៀបចំវាដោយខ្លួនឯង ដោយមាន AI ជាអ្នកណែនាំ។',
  },
  {
    title: 'A GitHub account',
    titleKm: 'គណនី GitHub',
    text: 'Free. This is where your website’s files are kept safe. We make it together on Day 1.',
    textKm: 'ឥតគិតថ្លៃ។ ជាកន្លែងរក្សាទុកឯកសារគេហទំព័ររបស់អ្នកដោយសុវត្ថិភាព។ យើងបង្កើតវាជាមួយគ្នានៅថ្ងៃទី ១។',
  },
  {
    title: 'A Cloudflare account',
    titleKm: 'គណនី Cloudflare',
    text: 'Free. This puts your website on the internet.',
    textKm: 'ឥតគិតថ្លៃ។ វាដាក់គេហទំព័ររបស់អ្នកនៅលើអ៊ីនធឺណិត។',
  },
];

const faqs = [
  {
    q: 'Do I need to know how to code?',
    qKm: 'តើខ្ញុំត្រូវចេះសរសេរកូដទេ?',
    a: 'No. You will see some code, and you will learn what it is, but the AI writes it. Your job is to know what you want and to say it clearly.',
    aKm: 'ទេ។ អ្នកនឹងឃើញកូដខ្លះ ហើយនឹងរៀនថាវាជាអ្វី ប៉ុន្តែ AI ជាអ្នកសរសេរវា។ ការងាររបស់អ្នក គឺដឹងថាអ្នកចង់បានអ្វី ហើយនិយាយវាឱ្យបានច្បាស់។',
  },
  {
    q: 'Can my website be in Khmer?',
    qKm: 'តើគេហទំព័ររបស់ខ្ញុំអាចជាភាសាខ្មែរបានទេ?',
    a: 'Yes. You can ask the AI to write in Khmer, or to make the site in both languages. Always have a Khmer speaker check the words — you know the language better than the AI does.',
    aKm: 'បាន។ អ្នកអាចប្រាប់ AI ឱ្យសរសេរជាភាសាខ្មែរ ឬធ្វើគេហទំព័រជាពីរភាសា។ តែងតែឱ្យអ្នកចេះភាសាខ្មែរពិនិត្យពាក្យពេចន៍ — អ្នកស្គាល់ភាសានេះច្បាស់ជាង AI។',
  },
  {
    q: 'Do I keep my website after the workshop?',
    qKm: 'តើខ្ញុំនៅតែមានគេហទំព័ររបស់ខ្ញុំក្រោយវគ្គសិក្សាទេ?',
    a: 'Yes. Everything is in your own GitHub and Cloudflare accounts. It is yours, and it stays online.',
    aKm: 'បាទ/ចាស។ អ្វីៗទាំងអស់នៅក្នុងគណនី GitHub និង Cloudflare ផ្ទាល់ខ្លួនរបស់អ្នក។ វាជារបស់អ្នក ហើយវានៅតែដំណើរការលើអ៊ីនធឺណិត។',
  },
  {
    q: 'What if the AI makes a mistake?',
    qKm: 'ចុះបើ AI ធ្វើខុស?',
    a: 'It will! Tell it what is wrong, the same way you would tell a person. If things get really messy, you can always go back to an earlier version.',
    aKm: 'វានឹងធ្វើខុសម្តងម្កាល! ប្រាប់វាថាអ្វីខុស ដូចដែលអ្នកប្រាប់មនុស្សម្នាក់។ ប្រសិនបើអ្វីៗរញ៉េរញ៉ៃខ្លាំង អ្នកតែងតែអាចត្រឡប់ទៅកំណែមុនវិញបាន។',
  },
];

const decks = getDecks();
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-brand/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-leaf"></span>
            A vibe coding workshop at New Hope Cambodia
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            Build a real website by <span class="text-brand">talking</span> to AI.
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">បង្កើតគេហទំព័រជាមួយ AI</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            No coding experience needed. Describe the website you want, watch the AI build it, and publish it to the internet by the end of the week.
            <span class="km" lang="km">មិនចាំបាច់មានបទពិសោធន៍សរសេរកូដទេ។ ពិពណ៌នាគេហទំព័រដែលអ្នកចង់បាន មើល AI បង្កើតវា ហើយដាក់វានៅលើអ៊ីនធឺណិតត្រឹមចុងសប្តាហ៍។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/lesson" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              See the lessons → <span lang="km" class="font-khmer font-normal opacity-80">មេរៀន</span>
            </a>
            <a href="#how" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              How it works <span lang="km" class="font-khmer font-normal opacity-60">របៀបដំណើរការ</span>
            </a>
          </div>
        </div>

        <!-- Illustration: a prompt on the left becomes a website on the right -->
        <div class="relative" aria-hidden="true">
          <div class="rounded-2xl bg-ink p-5 font-mono text-sm text-paper shadow-2xl">
            <div class="mb-4 flex gap-1.5">
              <span class="size-3 rounded-full bg-brand"></span>
              <span class="size-3 rounded-full bg-sun"></span>
              <span class="size-3 rounded-full bg-leaf"></span>
            </div>
            <p class="text-sun">&gt; Make a website for my family's bakery in Phnom Penh.</p>
            <p class="mt-1 text-sun">&nbsp;&nbsp;Warm colors, our menu, and a map.</p>
            <p class="mt-3 text-paper/60">✓ Created homepage</p>
            <p class="text-paper/60">✓ Added menu with 6 items</p>
            <p class="text-paper/60">✓ Added map and opening hours</p>
            <p class="mt-3 animate-pulse">▍</p>
          </div>
          <div class="relative -mt-6 mr-2 ml-auto w-60 rotate-[3deg] rounded-xl border border-ink/10 bg-white p-4 shadow-xl sm:w-72">
            <div class="h-20 rounded-lg bg-gradient-to-br from-sun to-brand"></div>
            <p class="mt-3 font-display font-bold">Sokha's Bakery</p>
            <p class="text-xs text-muted">Fresh bread every morning since 1998</p>
            <div class="mt-3 grid grid-cols-3 gap-2">
              <div class="h-8 rounded bg-paper"></div>
              <div class="h-8 rounded bg-paper"></div>
              <div class="h-8 rounded bg-paper"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="border-y border-ink/10 bg-white">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-extrabold text-brand">{s.value}</dd>
              <dd class="mt-1 text-sm text-muted">
                {s.label}
                <span class="km" lang="km">{s.labelKm}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">How it works <span lang="km" class="font-khmer font-normal">· របៀបដំណើរការ</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Four steps from idea to live website.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">បួនជំហាន ពីគំនិតមួយ ទៅជាគេហទំព័រដែលដំណើរការពិតប្រាកដ។</p>
      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s, i) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6">
              <div class="flex items-center justify-between">
                <span class="text-3xl">{s.icon}</span>
                <span class="font-display text-sm font-bold text-ink/30">0{i + 1}</span>
              </div>
              <h3 class="mt-4 font-display text-xl font-bold">
                {s.title}
                <span class="km text-base" lang="km">{s.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {s.text}
                <span class="km" lang="km">{s.textKm}</span>
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- BIG STATEMENT -->
    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-display text-3xl leading-tight font-bold text-balance sm:text-5xl">
          AI turns out to be <span class="text-sun">very good at writing code.</span> So the most useful skill now is knowing what to ask for.
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          AI ពិតជាពូកែសរសេរកូដណាស់។ ដូច្នេះ ជំនាញដែលមានប្រយោជន៍បំផុតនាពេលនេះ គឺការដឹងថាត្រូវស្នើសុំអ្វី។
        </p>
      </div>
    </section>

    <!-- LESSONS -->
    <section id="lessons" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Lessons <span lang="km" class="font-khmer font-normal">· មេរៀន</span></p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Start here.</h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ចាប់ផ្តើមនៅទីនេះ។</p>
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          decks.map((deck) => (
            <a
              href={`/lesson/${deck.slug}`}
              class="group flex flex-col rounded-2xl border border-ink/10 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-xl"
            >
              <span class="font-display text-sm font-bold tracking-wide text-brand uppercase">{deck.eyebrow}</span>
              <span class="mt-2 font-display text-2xl font-bold">
                {deck.title.replace(/^[^—]+—\s*/, '')}
                {deck.titleKm && <span class="km text-lg" lang="km">{deck.titleKm.replace(/^[^—]+—\s*/, '')}</span>}
              </span>
              <span class="mt-2 flex-1 text-muted">
                {deck.subtitle}
                {deck.subtitleKm && <span class="km" lang="km">{deck.subtitleKm}</span>}
              </span>
              <span class="mt-6 font-semibold text-brand">Open slides <span class="inline-block transition group-hover:translate-x-1">→</span> <span lang="km" class="font-khmer font-normal">បើកស្លាយ</span></span>
            </a>
          ))
        }
        <a
          href="/setup"
          class="group flex flex-col rounded-2xl border border-ink/10 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-xl"
        >
          <span class="font-display text-sm font-bold tracking-wide text-brand uppercase">Guide</span>
          <span class="mt-2 font-display text-2xl font-bold">
            Set up your Mac
            <span class="km text-lg" lang="km">រៀបចំកុំព្យូទ័រ Mac របស់អ្នក</span>
          </span>
          <span class="mt-2 flex-1 text-muted">
            Install the Claude app, then let the AI set up the rest of your computer.
            <span class="km" lang="km">ដំឡើងកម្មវិធី Claude បន្ទាប់មកឱ្យ AI រៀបចំផ្នែកផ្សេងទៀតនៃកុំព្យូទ័ររបស់អ្នក។</span>
          </span>
          <span class="mt-6 font-semibold text-brand">Open the guide <span class="inline-block transition group-hover:translate-x-1">→</span> <span lang="km" class="font-khmer font-normal">បើកការណែនាំ</span></span>
        </a>
      </div>
    </section>

    <!-- WHAT YOU NEED -->
    <section class="bg-white">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="font-semibold text-brand">Before you start <span lang="km" class="font-khmer font-normal">· មុនពេលចាប់ផ្តើម</span></p>
          <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">What you need</h2>
          <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">អ្វីដែលអ្នកត្រូវការ</p>
          <p class="mt-4 text-lg text-muted">
            That's the whole list. Everything else, the AI will help you install.
            <span class="km" lang="km">នោះហើយជាបញ្ជីទាំងមូល។ អ្វីៗផ្សេងទៀត AI នឹងជួយអ្នកដំឡើង។</span>
          </p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            needs.map((n) => (
              <li class="rounded-2xl bg-paper p-6">
                <span class="grid size-8 place-items-center rounded-full bg-leaf text-sm font-bold text-paper">✓</span>
                <h3 class="mt-4 font-display text-lg font-bold">
                  {n.title}
                  <span class="km text-base" lang="km">{n.titleKm}</span>
                </h3>
                <p class="mt-1 text-muted">
                  {n.text}
                  <span class="km" lang="km">{n.textKm}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="text-center font-display text-4xl font-extrabold tracking-tight">Questions</h2>
      <p class="km mt-2 text-center text-xl font-semibold" lang="km">សំណួរ</p>
