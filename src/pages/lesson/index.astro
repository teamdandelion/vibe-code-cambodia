---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getDecks } from '../../lib/decks';

const decks = getDecks();
---

<Base title="Lessons">
  <Header />
  <main class="mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="font-semibold text-brand">The workshop</p>
    <h1 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Lessons</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      One slide deck per day. Use the arrow keys to move through slides, or press <kbd class="rounded bg-ink/10 px-1.5">?</kbd> inside a deck to see every shortcut.
    </p>

    <ol class="mt-12 grid gap-4">
      {
        decks.map((deck) => (
          <li>
            <a
              href={`/lesson/${deck.slug}`}
              class="group flex items-center gap-6 rounded-2xl border border-ink/10 bg-white p-6 transition hover:-translate-y-0.5 hover:border-brand hover:shadow-lg"
            >
              <span class="flex-1">
                {deck.eyebrow && <span class="block text-sm font-bold tracking-wide text-brand uppercase">{deck.eyebrow}{deck.draft && <span class="ml-2 rounded bg-sun/30 px-1.5 py-0.5 text-xs text-ink">Draft · not on live site</span>}</span>}
                <span class="block font-display text-xl font-bold">{deck.title}</span>
                {deck.subtitle && <span class="mt-1 block text-muted">{deck.subtitle}</span>}
              </span>
              <span class="text-sm text-muted">{deck.slides.length} slides</span>
              <span class="text-2xl text-brand transition group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Base>
