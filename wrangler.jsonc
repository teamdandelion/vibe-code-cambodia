// Cloudflare Workers config. This site is pure static files, so there is no
// server code: Cloudflare just serves whatever `npm run build` puts in ./dist.
//
// IMPORTANT: "name" must match the Worker name you pick in the Cloudflare
// dashboard when you connect this repo, or builds will fail.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe-code-cambodia",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Turns on preview links: every branch and pull request gets its own private
  // copy of the site. Empty is fine; everything above applies to previews too.
  "previews": {}
}
